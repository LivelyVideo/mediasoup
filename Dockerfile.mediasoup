ARG BASE_URL=gcr.io/lively-video/video-foundation.libstreamshm:latest
FROM $BASE_URL AS base

ENV SRC_DIR /root/mediasoup
ENV BUILD_DIR /root/build/mediasoup

RUN mkdir -p ${BUILD_DIR} && mkdir -p ${SRC_DIR}

COPY worker ${SRC_DIR}/worker
COPY node ${SRC_DIR}/node
COPY package.json ${SRC_DIR}/package.json
COPY npm-scripts.mjs ${SRC_DIR}/npm-scripts.mjs


RUN \
  apt update && \
  apt -y upgrade && \
  apt install ninja-build && \
  apt -y upgrade python3 && \
  apt install -y python3-pip supervisor && \
  ln -s /usr/bin/python3 /usr/local/bin/python3 && \
  pip3 install meson

# nodejs
RUN apt-get install -y ca-certificates curl gnupg && \
  mkdir -p /etc/apt/keyrings && \
  curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
  export NODE_MAJOR=20 && \
  echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
  apt-get update && \
  apt-get install nodejs -y

RUN \
  cd ${SRC_DIR} && \
  rm -rf ${BUILD_DIR}/* && \
  npm install --ignore-scripts && \
  npm run worker:build && \
  npm run typescript:build

